// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "quants-generate",
  "build": {
    "dockerfile": "../.docker/Dockerfile",
    "context": "..",
    "args": {
      "COMPOSE_PROJ_NAME": "quants-generate",
      "KIND": "3.10"
    }
  },
  "mounts": [
    {"source": "/storage-01/common-ts/datasets/AMASS", "target": "/workspaces/quants-generate/stmc/datasets", "type": "bind"},
    {"source": "/storage-01/common-ts/deps", "target": "/workspaces/quants-generate/stmc/deps", "type": "bind"},
    {"source": "/storage-01/common-ts/models", "target": "/workspaces/quants-generate/stmc/pretrained_models", "type": "bind"}
  ],
  "onCreateCommand": "python -m pip install -e quants[dev]",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
				"ms-python.python",
				"tamasfe.even-better-toml",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff",
				"ms-toolsai.datawrangler"
      ]
    }
  },
  "runArgs": [
		"--shm-size=100G",
    "--memory=100g",
    "--memory-swap=100g",
		"--cpus=64",
		"--device", "nvidia.com/gpu=1",
		// "--network", "shared_net"
  ]
}
